[{"i": 0, "text": "Nobody sees the sacrifices behind a successful financial life.", "start": 0.35, "end": 4.579}, {"i": 1, "text": "They see the house.", "start": 4.899, "end": 6.033}, {"i": 2, "text": "They see the business.", "start": 6.353, "end": 7.608}, {"i": 3, "text": "They see the investments.", "start": 7.928, "end": 9.397}, {"i": 4, "text": "But they don't see the years of discipline behind them.", "start": 9.657, "end": 12.257}, {"i": 5, "text": "The money you didn't spend.", "start": 12.577, "end": 14.136}, {"i": 6, "text": "The opportunities you worked for.", "start": 14.456, "end": 16.242}, {"i": 7, "text": "The habits you built when nobody was watching.", "start": 16.502, "end": 19.261}, {"i": 8, "text": "Building wealth isn't always exciting.", "start": 19.581, "end": 21.945}, {"i": 9, "text": "Sometimes it's repetitive. Sometimes it's slow.", "start": 22.205, "end": 25.254}, {"i": 10, "text": "But consistency can take you further than chasing every shortcut.", "start": 25.514, "end": 29.255}, {"i": 11, "text": "Stay focused. Keep building.", "start": 29.575, "end": 31.461}, {"i": 12, "text": "Your future is worth the effort.", "start": 31.781, "end": 33.617}]